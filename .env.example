# Neon Postgres
DATABASE_URL=

# Site access (password only for now)
SITE_ACCESS_PASSWORD=ramsm
ACCESS_API_PORT=8787

# Public origin
APP_ORIGIN=https://pocketpills.vercel.app
VITE_APP_ORIGIN=https://pocketpills.vercel.app

# Optional: remote NMC HTTP API. If unset, the bundled CSV registry is used
# (required on Vercel — nmc-api does not run there).
# NMC_API_URL=
# NMC_API_KEY=

# Optional: remote DDA pharmacy HTTP API. If unset, bundled pharmacies.json is used.
# PHARMACY_API_URL=
# DDA_API_KEY=

# Optional: remote health-facility HTTP API. If unset, bundled health-facilities.json is used.
# HF_API_URL=
# HF_API_KEY=

# Ratings — dedicated Neon project `pocketpills-reviews` (recommended).
# Falls back to DATABASE_URL if REVIEWS_DATABASE_URL is unset (this is what
# Vercel uses today). An empty reviews table hides every public rating chip.
# Create/copy the pooled connection string and paste it here, and set both
# vars on Vercel. Providers cannot hide or delete reviews;
# only this platform key can call /api/reviews/platform.
# REVIEWS_DATABASE_URL=
# REVIEWS_PLATFORM_KEY=
